{
  "version": 2,
  "buildCommand": "npm run --prefix client build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install --prefix server && npm install --prefix client --include=dev",

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

